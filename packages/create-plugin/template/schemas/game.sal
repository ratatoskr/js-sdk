// The game's types. Every .sal in schemas/ is the "schema" module, so
// `import { Player } from "schema"`. `npm run types` and every build type it.
// Wraith's own types are in there too, like Vec3.

struct Player {
    [Offset(0x10)] u8[32] name;
    [Offset(0x30)] f32 health;
    [Offset(0x40)] Vec3 pos;
    [Offset(0x50)] Player* target;
}
