// The game's types. Every .sal in schemas/ is in this plugin's namespace, __NAMESPACE__, so scripts
// use `__NAMESPACE__.Player`. `npm run types` and every build type it. Wraith's own types are in
// scope too, like Vec3.

struct Player {
    [Offset(0x10)] u8[32] name;
    [Offset(0x30)] f32 health;
    [Offset(0x40)] Vec3 pos;
    [Offset(0x50)] Player* target;
}